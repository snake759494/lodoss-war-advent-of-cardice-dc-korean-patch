 },
 {
  "id": "t0876",
  "ko": "단련할 무구를 선택\n\n\n@A무구선택 @X설명"
 },
 {
  "id": "t0877",
  "ko": "마법무구 형태 변경\n\n\n@A변경 @X설명"
 },
 {
  "id": "t0878",
  "ko": "무구에 고대어를 끼우거나\n빼거나 새겨 넣는다\n\n@A고대어 @X설명"
 },
 {
  "id": "t0879",
  "ko": "무구를 만든다\n만들 수 있는 건 이제껏\n발견한 적 있는 것뿐\n@A무구선택 @X설명"
 },
 {
  "id": "t0880",
  "ko": "입수한 고대어 목록\n\n\n@A고대어목록 @X설명"
 },
 {
  "id": "t0881",
  "ko": "고대 단어가 없는 무구를\n해체해 미스릴로 환원\n\n@A해체품선택 @X설명"
 },
 {
  "id": "t0882",
  "ko": "무구 개조를 종료\n\n\n@A종료 @X설명"
 },
 {
  "id": "t0883",
  "ko": "무구 선택"
 },
 {
  "id": "t0884",
  "ko": "변형할 무구를 선택\n\n\n@A선택"
 },
 {
  "id": "t0885",
  "ko": "마법방어구 변형"
 },
 {
  "id": "t0886",
  "ko": "변경할 무구를 고릅니다\n함유량ＣＯＮＴＥＮＴ로\n미스릴이 증감합니다\n@A무구 선택 @X설명 전환"
 },
 {
  "id": "t0887",
  "ko": "고대단어 합성"
 },
 {
  "id": "t0888",
  "ko": "고대단어가 무구에 깃듦\nＦＵＳＩＯＮ 합성용\n미스릴이 소비됩니다\n@A합성 실행 @B취소"
 },
 {
  "id": "t0889",
  "ko": "상위고대단어 발생"
 },
 {
  "id": "t0890",
  "ko": "합성 한계로 발생한\n새 고대 단어가\n목록에 추가됩니다\n@A단어 추가"
 },
 {
  "id": "t0891",
  "ko": "아이템 복제"
 },
 {
  "id": "t0892",
  "ko": "만들 아이템을 고름\n복제비용ＣＯＮＴＥＮＴ를\n미스릴에서 소비합니다\n@A복제@Y소지품 @X전환"
 },
 {
  "id": "t0893",
  "ko": "무구 해체"
 },
 {
  "id": "t0894",
  "ko": "해체할 무구를 고름\n함유량ＣＯＮＴＥＮＴ만큼\n미스릴이 증가합니다\n@A선택"
 },
 {
  "id": "t0895",
  "ko": "ＦＵＳＩＯＮ 합성으로\n이 무구를 강화할\n고대단어가 없습니다\n@B취소"
 },
 {
  "id": "t0896",
  "ko": "쓸모없는무구가 있으면\nＲＥＦＩＮＥ로\n미스릴로 만들어 버리게나"
 },
 {
  "id": "t0897",
  "ko": "마법 무구를 강화하려면\nＳＥＬＥＣＴＯＮＥ에서\n하나를 골라 주게"
 },
 {
  "id": "t0898",
  "ko": "마법 무구를 강화하려면\nＡＮＣＩＥＮＴＳ를 골라\nＴＲＡＮＳＦＯＲＭ로\n변형시킬 수도 있다네"
 },
 {
  "id": "t0899",
  "ko": "오오 고대어의 진화일세！\n새로이 상위 에인션트를\n쓸 수 있게 되었네\n"
 },
 {
  "id": "t0900",
  "ko": "위대한 에인션트여！\n쇠에 새겨 힘을 깃들라！"
 },
 {
  "id": "t0901",
  "ko": "더 강화를 하려면\n미스릴이 더 필요하네\n@A복귀"
 },
 {
  "id": "t0902",
  "ko": "먼저 ＲＥＦＩＮＥ을 골라서\n전부 미스릴로 녹여 버리게\n뭐 걱정 말게！\n내 말대로 하면 되네"
 },
 {
  "id": "t0903",
  "ko": "다음은 ＳＥＬＥＣＴ ＯＮＥ로\n마법 검을 골라 주게"
 },
 {
  "id": "t0904",
  "ko": "ＡＮＣＩＥＮＴＳ를 골라\n고대 단어 대미지ＵＰ＋１을\n마법 검에 끼운 뒤\nＸ버튼을 누르게！！"
 },
 {
  "id": "t0905",
  "ko": "마법검에 고대단어가 없네\nＢ버튼을 눌러\nＡＮＣＩＥＮＴＳ를 다시 골라"
 },
 {
  "id": "t0906",
  "ko": "Ａ버튼을 눌러\n마법 검에 대미지ＵＰ＋１을\n합성하게나！！"
 },
 {
  "id": "t0907",
  "ko": "먼저 ＳＥＬＥＣＴ ＯＮＥ에서\n마법 갑옷을 고르게"
 },
 {
  "id": "t0908",
  "ko": "ＡＮＣＩＥＮＴＳ를 골라\n고대 단어 아머ＵＰ＋１을\n마법 갑옷에 끼운 뒤\nＸ버튼을 누르게！！"
 },
 {
  "id": "t0909",
  "ko": "마법갑옷에 고대단어 없네\nＢ버튼을 눌러\nＡＮＣＩＥＮＴＳ를 다시 골라"
 },
 {
  "id": "t0910",
  "ko": "Ａ버튼을 눌러\n마법 갑옷에 아머ＵＰ＋１을\n합성하게나！！"
 },
 {
  "id": "t0911",
  "ko": "먼저 ＳＥＬＥＣＴ ＯＮＥ에서\n마법 검을 골라 주게"
 },
 {
  "id": "t0912",
  "ko": "ＴＲＡＮＳＦＯＲＭ을 골라\n마법검을 세이버로 바꾸게！\n검 이름을 바꿀 수도 있다네\n좋은 이름을 붙여 보게"
 },
 {
  "id": "t0913",
  "ko": "그건 세이버가 아니지만\n뭐 됐다 치세\nＥＸＩＴ를 골라 종료하게"
 },
 {
  "id": "t0914",
  "ko": "음 좋네\nＥＸＩＴ를 골라 종료하게"
 },
