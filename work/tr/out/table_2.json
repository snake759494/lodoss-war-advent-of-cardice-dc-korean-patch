 },
 {
  "id": "t0798",
  "ko": "ＨＰ 자연회복 속도를\n２배로 높인다\n＜갑옷 합성×＞\n"
 },
 {
  "id": "t0799",
  "ko": "마나 활성화"
 },
 {
  "id": "t0800",
  "ko": "ＭＰ 최대치를 ２배로\n\n＜투구 합성×＞\n"
 },
 {
  "id": "t0801",
  "ko": "신의화신"
 },
 {
  "id": "t0802",
  "ko": "ＨＰ와ＭＰ 최대치\n５０％ ＵＰ\n＜방패 합성×＞\n"
 },
 {
  "id": "t0803",
  "ko": "마나여 살로"
 },
 {
  "id": "t0804",
  "ko": "ＨＰ 최대치 ３배\nＭＰ 최대치 １／２배\n＜검 합성불가＞\n"
 },
 {
  "id": "t0805",
  "ko": "말이여 힘이되라"
 },
 {
  "id": "t0806",
  "ko": "갑옷에 합성된 고대어\n수를 ＳＴＲ에 가산\n＜갑옷 합성×＞\n"
 },
 {
  "id": "t0807",
  "ko": "말이여 기술되라"
 },
 {
  "id": "t0808",
  "ko": "방패에 합성된 고대어\n수를 ＤＥＸ에 가산\n＜방패 합성×＞\n"
 },
 {
  "id": "t0809",
  "ko": "말이여 지혜되라"
 },
 {
  "id": "t0810",
  "ko": "투구에 합성된 고대어\n수를 ＩＮＴ에 가산\n＜투구 합성×＞\n"
 },
 {
  "id": "t0811",
  "ko": "말이여 검이되라"
 },
 {
  "id": "t0812",
  "ko": "검에 합성한 고대단어\n수를 대미지에 더한다\n＜검 합성불가＞\n"
 },
 {
  "id": "t0813",
  "ko": "바위깨는 검"
 },
 {
  "id": "t0814",
  "ko": "크리티컬 발생 시의\n대미지 배율을 ２배로\n＜검 합성불가＞\n"
 },
 {
  "id": "t0815",
  "ko": "검성 오의"
 },
 {
  "id": "t0816",
  "ko": "크리티컬 발생률을\n２배로\n＜검 합성불가＞\n"
 },
 {
  "id": "t0817",
  "ko": "검이여 빛"
 },
 {
  "id": "t0818",
  "ko": "휘두르는 속도 대폭 ＵＰ\n\n＜검 합성불가＞\n"
 },
 {
  "id": "t0819",
  "ko": "고블린을 일격필살\n\n＜검 합성불가＞\n"
 },
 {
  "id": "t0820",
  "ko": "엘프를 일격필살\n\n＜검 합성불가＞\n"
 },
 {
  "id": "t0821",
  "ko": "리자드맨을 일격에 처치\n\n＜검 합성불가＞\n"
 },
 {
  "id": "t0822",
  "ko": "현자의마력"
 },
 {
  "id": "t0823",
  "ko": "마력을 ２배로 한다\n\n＜투구 합성×＞\n"
 },
 {
  "id": "t0824",
  "ko": "검에서 화염탄 발사\n마법 벽이 유폭\n＜검 합성불가＞\n"
 },
 {
  "id": "t0825",
  "ko": "검에서 큰 화구를 발사\n착탄점 주위에 대미지\n＜검 합성불가＞\n"
 },
 {
  "id": "t0826",
  "ko": "검에서 거대한 폭발 발생\n광범위 큰 대미지\n＜검 합성불가＞\n"
 },
 {
  "id": "t0827",
  "ko": "검에서 성스러운 광탄발사\n벽 통과 아군ＨＰ 회복\n＜검 합성불가＞\n"
 },
 {
  "id": "t0828",
  "ko": "발키리 재블린"
 },
 {
  "id": "t0829",
  "ko": "검에서 성스러운 창 발사\n아군 ＨＰ를 회복한다\n＜검 합성불가＞\n"
 },
 {
  "id": "t0830",
  "ko": "검에서 성스러운 결계발생\n아군 ＨＰ를 회복한다\n＜검 합성불가＞\n"
 },
 {
  "id": "t0831",
  "ko": "검에서 번개를 발사한다\n생물 전반에 유효\n＜검 합성불가＞\n"
 },
 {
  "id": "t0832",
  "ko": "몸에 두르는 뇌광 발생\n닿는 적에게 방전\n＜검 합성불가＞\n"
 },
 {
  "id": "t0833",
  "ko": "작은 뇌구를 주위에 뿌림\n뇌구는 벽에 튕김\n＜검 합성불가＞\n"
 },
 {
  "id": "t0834",
  "ko": "강철의 몸"
 },
 {
  "id": "t0835",
  "ko": "물리방어력 아머를 ２배\n\n＜갑옷 합성×＞\n"
 },
 {
  "id": "t0836",
  "ko": "마이리 방패"
 },
 {
  "id": "t0837",
  "ko": "패링을 약 ２배로 한다\n\n＜방패 합성×＞\n"
 },
 {
  "id": "t0838",
  "ko": "부동의 강성"
 },
 {
  "id": "t0839",
  "ko": "내구력을 ２배로 한다\n\n＜갑옷 합성×＞\n"
 },
 {
  "id": "t0840",
  "ko": "기적의 몸놀림"
 },
 {
  "id": "t0841",
  "ko": "크리티컬 저항을\n２배로\n＜갑옷 합성×＞\n"
 },
 {
  "id": "t0842",
  "ko": "용신의 비늘"
 },
 {
  "id": "t0843",
  "ko": "어둠불꽃얼음번개 속성방어\n대폭 올린다\n＜투구 합성×＞\n"
 },
 {
  "id": "t0844",
  "ko": "발소리（풋스텝）가\n완전 소멸\n＜갑옷 합성×＞\n"
 },
 {
  "id": "t0845",
  "ko": "소리를 눈"
 },
 {
  "id": "t0846",
  "ko": "소리 발생지점을 시각화\n파문으로 적 위치 파악\n＜투구 합성×＞\n"
 },
 {
  "id": "t0847",
  "ko": "상처에 추격"
 },
 {
  "id": "t0848",
  "ko": "연속공격 대미지 증가\n효과는 ２타째와 ３타째\n＜검 합성불가＞\n"
 },
 {
  "id": "t0849",
  "ko": "전ＭＰ를 ＨＰ로 전환\nＭＰ는 ０ ＨＰ에 가산\n＜투구 합성×＞\n"
 },
 {
  "id": "t0850",
  "ko": "고통이여 마나로"
 },
 {
  "id": "t0851",
  "ko": "대미지를 받을수록\nＭＰ 회복\n＜방패 합성×＞\n"
 },
 {
  "id": "t0852",
  "ko": "입힌 대미지 중\n５０％를 ＨＰ로 흡수\n＜검 합성불가＞\n"
 },
 {
  "id": "t0853",
  "ko": "ＳＴＲ ２배의 대가로\n대미지의 ５％가 반사\n＜방패 합성×＞\n"
 },
 {
  "id": "t0854",
  "ko": "적의 강함과 입힌대미지에\n따라 미스릴이 나타난다\n＜검 합성불가＞\n"
 },
 {
  "id": "t0855",
  "ko": "바닥 함정을 안 밟음\n넘어지지 않게 된다\n＜갑옷 합성×＞\n"
 },
 {
  "id": "t0856",
  "ko": "마력을 ２배로\n대가로ＭＰ가 점차 감소\n＜투구 합성×＞\n"
