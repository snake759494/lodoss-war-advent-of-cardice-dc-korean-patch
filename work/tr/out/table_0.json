 {
  "id": "t0147",
  "ko": "고대 단어의 힘으로\n받은 대미지의 ２５％를\nＭＰ에 더한다\n"
 },
 {
  "id": "t0148",
  "ko": "레비테이션"
 },
 {
  "id": "t0149",
  "ko": "고대 단어의 힘으로\n바닥 함정을 안 밟음\n\n"
 },
 {
  "id": "t0150",
  "ko": "야만생명력"
 },
 {
  "id": "t0151",
  "ko": "고대 단어의 힘으로\n전ＭＰ를 ＨＰ에 더함\nＭＰ는 ０\n마법 사용 불가"
 },
 {
  "id": "t0152",
  "ko": "마력폭주"
 },
 {
  "id": "t0153",
  "ko": "고대 단어의 힘으로\n마력이 ２배가 된다\n대가로\nＭＰ가 조금씩 줄어든다"
 },
 {
  "id": "t0154",
  "ko": "유폭검"
 },
 {
  "id": "t0155",
  "ko": "베기만 해도\n마법벽이 폭발\n이웃한 마법벽은\n연쇄 유폭한다"
 },
 {
  "id": "t0156",
  "ko": "고블린 킬러"
 },
 {
  "id": "t0157",
  "ko": "고대 단어의 힘으로\n모든 고블린을\n반드시 일격에 죽인다\n"
 },
 {
  "id": "t0158",
  "ko": "엘프 킬러"
 },
 {
  "id": "t0159",
  "ko": "고대 단어의 힘으로\n모든 엘프를\n반드시 일격에 죽인다\n"
 },
 {
  "id": "t0160",
  "ko": "리자드맨 킬러"
 },
 {
  "id": "t0161",
  "ko": "고대 단어의 힘으로\n모든 리자드맨을\n반드시 일격에 죽인다\n"
 },
 {
  "id": "t0162",
  "ko": "뱀파이어 송곳니"
 },
 {
  "id": "t0163",
  "ko": "고대 단어의 힘으로\n준 대미지의 ５０％만큼\nＨＰ를 회복\n"
 },
 {
  "id": "t0164",
  "ko": "미스릴로의 재생"
 },
 {
  "id": "t0165",
  "ko": "고대 단어의 힘으로\n적을 죽이면\n적의 강함과 준 대미지에\n따라 미스릴이 출현한다"
 },
 {
  "id": "t0166",
  "ko": "대미지 증폭"
 },
 {
  "id": "t0167",
  "ko": "고대 단어의 힘으로\n연속공격 대미지 증가\n２타와 ３타에만 효과\n"
 },
 {
  "id": "t0168",
  "ko": "모아치기 단축"
 },
 {
  "id": "t0169",
  "ko": "Ｂ버튼에 의한 모아치기로\n공격 가능해질 때까지의\n시간이 단축\n"
 },
 {
  "id": "t0170",
  "ko": "석화무효"
 },
 {
  "id": "t0171",
  "ko": "석화를 완전 방지\n\n\n"
 },
 {
  "id": "t0172",
  "ko": "충격무효"
 },
 {
  "id": "t0173",
  "ko": "적의 공격으로\n비틀거리지 않게 된다\n\n"
 },
 {
  "id": "t0174",
  "ko": "후퇴무효"
 },
 {
  "id": "t0175",
  "ko": "적의 공격으로\n뒤로 안 밀려난다\n\n"
 },
 {
  "id": "t0176",
  "ko": "전도무효"
 },
 {
  "id": "t0177",
  "ko": "적의 공격으로\n쓰러지지 않는다\n드래곤엔 효과 없음\n"
 },
 {
  "id": "t0178",
  "ko": "에너지 드레인 무효"
 },
 {
  "id": "t0179",
  "ko": "ＨＰ흡수 공격을 받아도\n적 ＨＰ 회복 안됨\n\n"
 },
 {
  "id": "t0180",
  "ko": "ＭＰ드레인무효"
 },
 {
  "id": "t0181",
  "ko": "ＭＰ흡수 공격을 받아도\n적 ＭＰ 회복 안됨\n\n"
 },
 {
  "id": "t0182",
  "ko": "음원감지"
 },
 {
  "id": "t0183",
  "ko": "적의 소리를 시각화\n파문으로\n벽 뒤나 투명한 적의\n위치를 알 수 있다"
 },
 {
  "id": "t0184",
  "ko": "함정 무효"
 },
 {
  "id": "t0185",
  "ko": "함정을 피한다\n\n\n"
 },
 {
  "id": "t0186",
  "ko": "함정 감지"
 },
 {
  "id": "t0187",
  "ko": "바닥에 떨어진 함정의\n위치가 빛난다\n위험하면 붉은 빛\n"
 },
 {
  "id": "t0188",
  "ko": "아이템 감지"
 },
 {
  "id": "t0189",
  "ko": "바닥에 떨어진 아이템의\n위치가 빛난다\n\n"
 },
 {
  "id": "t0190",
  "ko": "인비저블"
 },
 {
  "id": "t0191",
  "ko": "투명 상태\n적에 접근하면\n효과 소멸\n"
 },
 {
  "id": "t0192",
  "ko": "투명효과"
 },
 {
  "id": "t0193",
  "ko": "투명 상태이다\n몬스터에 다가가면 효과가\n사라진다\n"
 },
 {
  "id": "t0194",
  "ko": "히트 바디"
 },
 {
  "id": "t0195",
  "ko": "불꽃을 두르고 있다\n닿은 적에 불꽃 대미지\n준다\n시간 경과로 소멸"
 },
 {
  "id": "t0196",
  "ko": "프리징 바디"
 },
 {
  "id": "t0197",
  "ko": "냉기를 두르고 있다\n닿은 적에 냉기 대미지\n준다\n시간 경과로 소멸"
 },
 {
  "id": "t0198",
  "ko": "번개를 두르고 있다\n닿는 적에 연쇄\n뇌격을 계속 가함\n시간 경과로 소멸"
 },
 {
  "id": "t0199",
  "ko": "투명 상태\n적에 접근하면\n효과 소멸\n시간으로도 소멸"
 },
 {
  "id": "t0200",
  "ko": "고스트 바디"
 },
 {
  "id": "t0201",
  "ko": "육체를 떠난 영혼은\n들키지 않고 이동 가능\n육체가 대미지를 받거나\n시간 경과로 소멸"
 },
 {
  "id": "t0202",
  "ko": "럭키"
 },
 {
  "id": "t0203",
  "ko": "크리티컬을 받지 않고\n쓰러지지도 않는다\n드래곤엔 효과 없음\n시간 경과로 소멸"
 },
 {
  "id": "t0204",
  "ko": "이모탈 바디"
 },
 {
  "id": "t0205",
  "ko": "모든 대미지로부터\n해방된다\n완전 무적 상태\n시간 경과로 소멸"
 },
 {
  "id": "t0206",
  "ko": "루제브 머리"
 },
 {
  "id": "t0207",
  "ko": "【어둠의 숲】을 다스린\n족장을 처치한 증거\n사룡 나스에게 바쳐라\n"
 },
 {
  "id": "t0208",
  "ko": "쇼델의 머리"
 },
 {
  "id": "t0209",
  "ko": "해골 조각상"
 },
 {
  "id": "t0210",
  "ko": "마신의 메달"
 },
 {
  "id": "t0211",
  "ko": "요마 소굴 보스의 증표\n다크엘프 마을에서\n아이템과 교환 가능\n"
 },
 {
  "id": "t0212",
  "ko": "【어둠의 숲】을 다스린\n족장을 처치한 증거\n\n"
 },
 {
  "id": "t0213",
  "ko": "【암흑신전】을 지배하던\n대사제를 처치한 증거\n사룡 나스에게 바쳐라\n"
 },
 {
  "id": "t0214",
  "ko": "루제브와 쇼델의 머리와\n맞바꿔 나스에게서 입수\n정복자 성의 입구를 연다\n"
 },
 {
  "id": "t0215",
  "ko": "요마굴 보스가\n지닌 코인\n끝없는 마력이 감돈다\n"
 },
 {
  "id": "t0216",
  "ko": "쇼트소드"
 },
 {
  "id": "t0217",
  "ko": "다루기 쉬운 한손 단검\n검 중 두번째로 가볍다\n위력은 작으나 빠르다\n"
 },
 {
  "id": "t0218",
  "ko": "세이버"
 },
 {
  "id": "t0219",
  "ko": "날이 얇은 한손 장검\n임팩트가 약한 결점을\n균형감으로 보완한다\n"
 },
 {
  "id": "t0220",
  "ko": "레이피어"
 },
 {
  "id": "t0221",
  "ko": "가는 한손 장검\n크리티컬 성능 우수\n다루려면 ＤＥＸ가 필요\n"
 },
 {
  "id": "t0222",
  "ko": "시미터"
 },
 {
  "id": "t0223",
  "ko": "쉬운 한손용 곡도\n대미지가 안정적이라\n초보자에 적합\n"
 },
 {
  "id": "t0224",
  "ko": "글라디우스"
 },
 {
  "id": "t0225",
  "ko": "최속의 한손 단검\n검이 짧은 것 외에는\n뛰어난 성능을 지녔다\n"
 },
 {
  "id": "t0226",
  "ko": "라이트닝 대거"
 },
 {
  "id": "t0227",
  "ko": "번개 속성의 한손 단검\n물리 방어 무시 효과로\n성능은 믿을 만하다\n"
 },
 {
  "id": "t0228",
  "ko": "폴천"
 },
 {
  "id": "t0229",
  "ko": "넓은 한손 장검\n큰 임팩트가 특징\n다루려면 ＳＴＲ이 필요\n"
 },
 {
  "id": "t0230",
  "ko": "블레이징 소드"
 },
 {
  "id": "t0231",
  "ko": "불꽃 속성의 한손 장검\n유폭 속성으로 마법벽과\n조합하면 효과가 크다\n"
 },
 {
  "id": "t0232",
  "ko": "롱소드"
 },
 {
  "id": "t0233",
  "ko": "균형 잡힌 한손용 장검\n성능은 중간\n중급 이상 검사가 애용\n"
 },
 {
  "id": "t0234",
  "ko": "브로드소드"
 },
 {
  "id": "t0235",
  "ko": "검신 넓은 한손 장검\n롱소드와 비슷한 성능\n강한 임팩트가 특징\n"
 },
 {
  "id": "t0236",
  "ko": "엘리멘탈 보글"
 },
 {
  "id": "t0237",
  "ko": "특이한 영력의 한손 장검\n엘리멘탈계에 절대적 위력\n크리티컬 성능도 높다\n"
 },
 {
  "id": "t0238",
  "ko": "미스릴 블레이드"
 },
 {
  "id": "t0239",
  "ko": "미스릴 합금 양손용 장검\n비늘도 벤다\n가볍고 강력한 궁극품\n"
 },
 {
  "id": "t0240",
  "ko": "바스타드 소드"
 },
 {
  "id": "t0241",
  "ko": "사악한 자를 베는 장검\n몬스터에 성능 이상 위력\n상급 검사가 선호\n"
 },
 {
  "id": "t0242",
  "ko": "윈드 힐트"
 },
 {
  "id": "t0243",
  "ko": "바람의 영검은 무형\n거센 바람이 적을 흔든다\n날개 달린 자엔 치명\n"
 },
 {
  "id": "t0244",
  "ko": "플랑베르주"
 },
 {
  "id": "t0245",
  "ko": "다루기 쉬운 양손검\n대미지가 낮은 결점을\n크리티컬 배율로 보완\n"
 },
 {
  "id": "t0246",
  "ko": "드래곤 블레이드"
 },
 {
  "id": "t0247",
  "ko": "용살자라 불리는 한손검\n용 계열 적에도 효과\n일류 검사만이 지닌다\n"
 },
 {
  "id": "t0248",
  "ko": "팔크스"
 },
 {
  "id": "t0249",
  "ko": "베기에 중점을 둔 설계\n양손검 중 가장 빠름\n크리티컬률이 뛰어나다\n"
 },
 {
  "id": "t0250",
  "ko": "소울 브레이커"
 },
 {
  "id": "t0251",
  "ko": "ＨＰ 흡수 마력을 지님\n비틀거린 적은 마비된다\n언데드에겐 대미지 반감\n"
 },
 {
  "id": "t0252",
  "ko": "투핸디드 소드"
 },
 {
  "id": "t0253",
  "ko": "표준 양손용 장검\n믿을 만한 대미지와\n큰 임팩트가 매력\n"
 },
 {
  "id": "t0254",
  "ko": "스톤 크러셔"
 },
 {
  "id": "t0255",
  "ko": "다른 이름은 골렘 킬러\n이 무시무시한 곤봉은\n바위를 부수는 마력\n"
 },
 {
  "id": "t0256",
  "ko": "녹다운 해머"
 },
 {
  "id": "t0257",
  "ko": "강철도 꿰뚫는 위력\n중무장한 자에 철퇴를\n모두 땅을 기게 되리라\n"
 },
 {
  "id": "t0258",
  "ko": "클레이모어"
 },
 {
  "id": "t0259",
  "ko": "초보도 쓰기 쉬운 양손검\n크리티컬 성능 우수\n검신이 짧은 게 결점\n"
 },
 {
  "id": "t0260",
  "ko": "데몬 퍼니셔"
 },
 {
  "id": "t0261",
  "ko": "데몬에게 절대적 위력\n데몬 특징을 지닌 적에도\n충분한 효과가 있다\n"
 },
 {
  "id": "t0262",
  "ko": "그레이트 소드"
 },
 {
  "id": "t0263",
  "ko": "누구나 만족할 성능\n강하고 안정된 임팩트와\n대미지로 타를 압도한다\n"
 },
 {
  "id": "t0264",
  "ko": "허큘린 소드"
 },
 {
  "id": "t0265",
  "ko": "절대적 위력은 형언 불가\n최대 대미지를 지닌 거검\n무거워 범인은 못 쓴다\n"
 },
 {
  "id": "t0266",
  "ko": "오리엔탈 소드"
 },
 {
  "id": "t0267",
  "ko": "도는 크리티컬에 특화됐다\n다루기 어려운 명검\n검성만이 진가를 발휘한다\n"
 },
 {
  "id": "t0268",
  "ko": "엘븐 레이피어"
 },
 {
  "id": "t0269",
  "ko": "영력이 깃든 레이피어\n아인종에 높은 효과\n쓰기 쉽기로 정평\n"
 },
 {
  "id": "t0270",
  "ko": "오거 소드"
 },
 {
  "id": "t0271",
  "ko": "오거족의 영검\n고블린과 리자드맨을\n일격에 베어 죽인다\n"
 },
 {
  "id": "t0272",
  "ko": "팔리스 블레이드"
 },
 {
  "id": "t0273",
  "ko": "신의 성속성을 지닌 영검\n언데드와 데몬에게\n치명적 대미지를 준다\n"
 },
 {
  "id": "t0274",
  "ko": "위키드 소드"
 },
 {
  "id": "t0275",
  "ko": "엘프가 두려워할 마검\n마신의 저주가 깃들어\n마법 쓰는 자를 지옥으로\n"
 },
 {
  "id": "t0276",
  "ko": "메이지블레이드"
 },
 {
  "id": "t0277",
  "ko": "모아치기를 단축하는 검\n이 검을 다루려면\n공격마법 고대단어 필요\n"
 },
 {
  "id": "t0278",
  "ko": "브레스트플레이트"
 },
 {
  "id": "t0279",
  "ko": "최경장 갑옷\n방어력이 불안\n초보자용\n"
 },
 {
  "id": "t0280",
  "ko": "하프 플레이트"
 },
 {
  "id": "t0281",
  "ko": "브레스트플레이트 발전형\n방어력은 기대 어렵다\n\n"
 },
 {
  "id": "t0282",
  "ko": "라이트플레이트"
 },
 {
  "id": "t0283",
  "ko": "경량 플레이트 메일\n소재가 얇은 판금이라\n내구력이 낮다\n"
